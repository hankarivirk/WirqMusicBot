# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather on telegram
BOT_TOKEN=
LOGGER_ID=

# mongo url from cloud.mongodb.com
MONGO_URL=

OWNER_ID=

# pyrogram session from @StringFatherBot on telegram
SESSION=

# ── Branding / links shown inside the bot ──
# Link behind the "Owner" button on /start (your Telegram profile or channel)
OWNER_URL=https://t.me/your_username
# Link behind the "Support" button
SUPPORT_CHAT=https://t.me/your_support_group
# Link behind the "Channel" button
SUPPORT_CHANNEL=https://t.me/your_channel

# ── Thumbnail branding ──
# Leave BRAND_NAME empty to auto-use your bot's own Telegram name
BRAND_NAME=
BRAND_TAG=Lossless
