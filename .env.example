# ====================================================================
# WirqMusic Bot - Environment Configuration
# Bot Name: Wirq Music Bot
# Owner: @wirq4 | Support: @wirqbots | GitHub: Hankarivirk/WirqMusicbot
# ====================================================================

# [REQUIRED] Telegram Core API Credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# [REQUIRED] Bot Owner User ID (numeric Telegram user ID for @wirq4)
OWNER_ID=1234567890

# [REQUIRED] Telegram Log / Dump Group ID (must start with -100)
LOGGER_ID=-1001234567890

# [REQUIRED] Pyrogram Assistant String Session(s) for Voice Chat streaming
# Generate using an assistant user account via Pyrogram / Termux / script
SESSION=BQC...your_pyrogram_session_string_here...
# Optional additional assistant sessions for multi-assistant load balancing
SESSION2=
SESSION3=

# [OPTIONAL / RECOMMENDED] MongoDB Connection URL
# If omitted, WirqMusic automatically falls back to local JSON persistence
MONGO_URL=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# [OPTIONAL] Community Branding & Links
SUPPORT_CHANNEL=https://t.me/wirqbots
SUPPORT_CHAT=https://t.me/wirqbots
OWNER_URL=https://t.me/wirq4
GITHUB_REPO=https://github.com/Hankarivirk/WirqMusicbot

# [OPTIONAL] Custom Thumbnail URLs
START_THUMBNAIL_URL=https://telegra.ph/file/0c32988168bbd4e78f99e.jpg
PING_THUMBNAIL_URL=https://telegra.ph/file/0c32988168bbd4e78f99e.jpg
SONG_THUMBNAIL_DEFAULT=https://telegra.ph/file/0c32988168bbd4e78f99e.jpg
THUMB_GEN=True

# [OPTIONAL] Playback & Queue Limits
DURATION_LIMIT=60
QUEUE_LIMIT=50
PLAYLIST_LIMIT=200
VIDEO_PLAY=True
AUTO_END=True

# [OPTIONAL] Voice Chat Automation & Cleanup
AUTO_LEAVE=True
AUTO_LEAVE_GRACE=15
CLEANUP_INTERVAL=1800
CLEANUP_MAX_AGE=7200

# [OPTIONAL] Default Language (en / hi / pa)
LANG_CODE=en

# [OPTIONAL] YouTube Cookie Links (separated by spaces)
COOKIES_URL=
